# ── Backend Supabase (server only) ─────────────────────────────────────────
# Where to get: same Supabase dashboard, but the service role key MUST NEVER
# leave the server. Do not put it in a VITE_ variable.
SUPABASE_URL=                # Supabase project URL
SUPABASE_ANON_KEY=           # Supabase anon key
SUPABASE_SERVICE_ROLE_KEY=   # Supabase service role key (server-only)

# ── Database (Postgres) ────────────────────────────────────────────────────
# Where to get: Supabase → Project Settings → Database → Connection String.
# Use the TRANSACTION POOLER string (port 6543). Note the pooler cluster
# number in the host (aws-0 / aws-1 / …) — it must match your project's.
DATABASE_URL=                # postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_SSL=true            # false only for a local Supabase/Postgres instance
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# ── AI ─────────────────────────────────────────────────────────────────────
# Every AI call routes through api/lib/ai.ts. Pick ONE provider:
#   mock       – no key needed; realistic canned JSON (zero-cost development)
#   gemini     – FREE tier: https://aistudio.google.com/apikey (no card)
#   groq       – FREE tier: https://console.groq.com (GPT-OSS and other models)
#   openrouter – free-tier models: https://openrouter.ai/keys
#   anthropic  – Claude (paid): https://console.anthropic.com
# Select mock explicitly for fixture output. Missing live keys return an availability error.
# For REAL confidential data use a provider/tier that carries a data-processing
# agreement (Google AI Studio's free tier does not) and then set
# AI_DATA_PROCESSING_APPROVED=true below; every live AI call refuses to run in
# production until you do (mock output is unaffected).
AI_PROVIDER=mock
AI_MODEL=                    # optional override; each provider has a sane default

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ── Email (Phase 11.4; optional) ───────────────────────────────────────────
# Where to get: https://resend.com → API Keys. Absent ⇒ notification emails
# are logged and skipped (the app works fine without it).
RESEND_API_KEY=
EMAIL_FROM=Ansyra <notifications@example.com>

# ── Monitoring (Phase 13.4; optional) ──────────────────────────────────────
# Where to get: https://sentry.io → your project → Settings → Client Keys (DSN).
# Absent ⇒ no SDK is loaded and nothing is reported.
SENTRY_DSN=                  # server-side errors (Hono/tRPC/process)
VITE_SENTRY_DSN=             # browser-side errors (React)
VITE_SENTRY_RELEASE=         # optional release tag baked into the frontend

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_MODE=demo                # demo permits mock AI; production requires real AI/email/cron
PORTFOLIO_DEMO=false         # displays portfolio disclosures only; does not change uploads, editing or AI
PORT=3000
SITE_URL=http://localhost:3000
TRUST_PROXY_HEADERS=false    # true only behind Render/Railway/Koyeb/Cloud Run
# With proxy trust on, ONLY this header is read for the client address, and the
# client is the entry TRUSTED_PROXY_HOPS from the right (the one your proxy
# appended). Entries a client prepends itself are ignored, so a spoofed header
# cannot mint fresh rate-limit buckets. Do not name a header your proxy does
# not overwrite/append.
PROXY_IP_HEADER=x-forwarded-for
TRUSTED_PROXY_HOPS=1
# Requests on any host other than SITE_URL's are redirected to it (GET/HEAD)
# or refused (writes). Mutations already require Origin === SITE_URL, so a user
# on the platform's default hostname could otherwise browse but never sign in.
CANONICAL_HOST_REDIRECT=true
ALLOW_CROSS_SITE_EMBEDDING=false
ALLOW_INSECURE_SITE_URL=false # local Docker smoke tests only; never set on a hosted deployment
CRON_SECRET=                 # long random value used by POST /internal/cron/deadlines
EXTERNAL_REQUEST_TIMEOUT_MS=45000
LEGAL_REVIEW_COMPLETE=false  # production acknowledgement; counsel must actually complete review
BACKUP_RESTORE_TESTED=false  # production acknowledgement after a successful restore drill
# Required for ANY live AI call whenever NODE_ENV=production, in every APP_MODE —
# deal, assumption and full document text is sent to the provider.
AI_DATA_PROCESSING_APPROVED=false
# Only when running behind a TLS-terminating proxy (e.g. cloud IDE ingress):
# HMR_CLIENT_PORT=443

# ── Seeded test accounts (Thornevale synthetic dataset) ─────────────────────
# Passwords for the four seeded accounts. NEVER commit real values.
# Leave unset locally: `npm run seed:thornevale` generates strong passwords and
# writes them to .env.seed.local (gitignored). Set them explicitly in a
# deployment so you control the credentials there.
SEED_PARTNER_PASSWORD=
SEED_ASSOCIATE_PASSWORD=
SEED_RIVAL_PASSWORD=
SEED_ADMIN_PASSWORD=

# Portfolio app allowances (not provider quotas). Each day window is 24 hours from first use.
AI_USER_MINUTE_LIMIT=20
AI_USER_DAY_LIMIT=20
AI_PLATFORM_MINUTE_LIMIT=5
AI_PLATFORM_DAY_LIMIT=100
# Text analysis and source-backed research are configured separately.
AI_RESEARCH_MODEL=gemini-2.5-flash
# Set AI_MODEL=gemini-3.8-flash with AI_PROVIDER=gemini after validation.

# Optional public contact shown on legal pages (not an account credential).
VITE_PUBLIC_CONTACT_EMAIL=
