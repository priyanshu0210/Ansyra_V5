{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild api/boot.ts --platform=node --bundle --format=esm --outdir=dist --external:@sentry/node --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);\"",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "start": "NODE_ENV=production node dist/boot.js",
    "check": "tsc -b",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:migrate": "supabase db push",
    "db:status": "supabase migration list",
    "db:local:start": "supabase start",
    "db:local:reset": "supabase db reset --local --yes",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "audit:all": "npm audit --audit-level=moderate",
    "verify": "npm run check && npm run lint && npm test && npm run build && npm run audit:prod && npm run audit:all && npm run check:publication",
    "seed:thornevale": "tsx --tsconfig tsconfig.server.json scripts/seed-thornevale.ts",
    "seed:thornevale:verify": "tsx --tsconfig tsconfig.server.json scripts/seed-thornevale.ts --verify",
    "seed:thornevale:check": "tsx --tsconfig tsconfig.server.json scripts/seed-thornevale.ts --check",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:regression": "vitest run --config vitest.regression.config.ts",
    "test:e2e": "playwright test",
    "seed:thornevale:clear-scratch": "tsx --tsconfig tsconfig.server.json scripts/seed-thornevale.ts --clear-scratch",
    "smoke": "tsx --tsconfig tsconfig.server.json scripts/smoke-deployment.ts",
    "release:preflight": "tsx --tsconfig tsconfig.server.json scripts/release-preflight.ts",
    "release:preflight:local": "tsx --tsconfig tsconfig.server.json scripts/test-local.ts preflight",
    "test:local:configure": "tsx --tsconfig tsconfig.server.json scripts/configure-local-tests.ts",
    "test:local:seed": "tsx --tsconfig tsconfig.server.json scripts/test-local.ts seed",
    "test:local:integration": "tsx --tsconfig tsconfig.server.json scripts/test-local.ts integration",
    "test:local:regression": "tsx --tsconfig tsconfig.server.json scripts/test-local.ts regression",
    "test:local:e2e": "tsx --tsconfig tsconfig.server.json scripts/test-local.ts e2e",
    "check:publication": "node scripts/check-publication.mjs"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/node": "^10.65.0",
    "@sentry/react": "^10.65.0",
    "@supabase/supabase-js": "2.112.4",
    "@tanstack/react-query": "^5.90.16",
    "@trpc/client": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookie": "^1.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.42.2",
    "hono": "4.13.5",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.12.0",
    "pg": "^8.13.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.70.0",
    "react-resizable-panels": "^4.2.2",
    "react-router": "7.18.2",
    "react-router-dom": "7.18.2",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.4.0",
    "three": "^0.185.0",
    "unpdf": "^1.6.2",
    "vaul": "^1.1.2",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@hono/vite-dev-server": "^0.19.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "esbuild": "0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "supabase": "2.115.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.11"
  }
}
